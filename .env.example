# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role key (secret). Only ever used on the server.
SUPABASE_SERVICE_ROLE_KEY=

# Password your supervisor types at /admin
ADMIN_PASSWORD=
# Any long random string (used to sign the admin login cookie)
SESSION_SECRET=

# Shown in the header
NEXT_PUBLIC_SCHOOL_NAME=Drivers Ed
